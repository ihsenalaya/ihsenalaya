import time
import re
from datetime import datetime, timedelta
import pytz
from azure.identity import AzureCliCredential
from azure.mgmt.compute import ComputeManagementClient
from azure.mgmt.subscription import SubscriptionClient

# Set up your Azure credentials and client
tenant_id = "tenantid"
subscription_client = SubscriptionClient(AzureCliCredential())
compute_client = ComputeManagementClient(AzureCliCredential(), subscription_id='your_subscription_id')

# Define the function to get enabled subscriptions
def get_enabled_subscriptions():
    subscriptions = []
    for sub in subscription_client.subscriptions.list():
        if sub.state == 'Enabled' and re.match(r"^(PRD|PPD|OTH)[ \t]-[ \t]", sub.display_name):
            subscriptions.append(sub)
    return subscriptions

# Convert to Europe/Paris time zone
def get_current_time():
    tz = pytz.timezone('Europe/Paris')
    return datetime.now(tz)

# Define the AutoShutdown logic
def check_and_shutdown_vms(subscription):
    now = get_current_time()
    current_day = now.strftime('%A')

    # Get all VMs in the subscription
    vms = compute_client.virtual_machines.list_all()
    for vm in vms:
        if vm.tags and 'AutoShutdown' in vm.tags:
            auto_shutdown_value = vm.tags['AutoShutdown']
            # Regex check
            if not re.match(r"^Monday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Tuesday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Wednesday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Thursday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Friday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Saturday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Sunday (((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE)$", auto_shutdown_value):
                print(f"AutoShutdown tag value not valid | {subscription.display_name} | {vm.name} | {vm.power_state} | {auto_shutdown_value}")
            else:
                # If the AutoShutdown value is valid, proceed with the logic
                print(f"{subscription.display_name} | {vm.name} | {vm.power_state} | {auto_shutdown_value}")

                auto_shutdown_days = auto_shutdown_value.split(";")
                start_datetime = None
                stop_datetime = None

                for auto_shutdown_day in auto_shutdown_days:
                    if auto_shutdown_day.split(" ")[0].lower() == current_day.lower():
                        if auto_shutdown_day.split(" ")[1].lower() != "none":
                            start_time = auto_shutdown_day.split(" ")[1].split("-")[0]
                            stop_time = auto_shutdown_day.split(" ")[1].split("-")[1]
                            start_datetime = datetime.strptime(f"{now.strftime('%Y-%m-%d')} {start_time}", '%Y-%m-%d %I:%M%p')
                            stop_datetime = datetime.strptime(f"{now.strftime('%Y-%m-%d')} {stop_time}", '%Y-%m-%d %I:%M%p')

                if start_datetime and stop_datetime:
                    if vm.power_state != "VM running" and now < stop_datetime and now + timedelta(minutes=10) >= start_datetime:
                        compute_client.virtual_machines.start(subscription_id=subscription.id, resource_group_name=vm.resource_group_name, vm_name=vm.name)
                        print(f"Start VM | {subscription.display_name} | {vm.name} | {vm.power_state} | {auto_shutdown_value}")

                if not start_datetime or not stop_datetime:
                    if vm.power_state != "VM deallocated":
                        compute_client.virtual_machines.deallocate(subscription_id=subscription.id, resource_group_name=vm.resource_group_name, vm_name=vm.name)
                        print(f"Stop VM | {subscription.display_name} | {vm.name} | {vm.power_state} | {auto_shutdown_value}")

                if start_datetime and stop_datetime and vm.power_state != "VM deallocated" and now >= stop_datetime + timedelta(minutes=10):
                    compute_client.virtual_machines.deallocate(subscription_id=subscription.id, resource_group_name=vm.resource_group_name, vm_name=vm.name)
                    print(f"Stop VM | {subscription.display_name} | {vm.name} | {vm.power_state} | {auto_shutdown_value}")

# Main function
def main():
    subscriptions = get_enabled_subscriptions()
    for subscription in subscriptions:
        check_and_shutdown_vms(subscription)

if __name__ == "__main__":
    main()
