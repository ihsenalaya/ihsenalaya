from future import annotations

import re import sys from datetime import datetime, timedelta from typing import Tuple

from zoneinfo import ZoneInfo

from azure.identity import DefaultAzureCredential from azure.mgmt.compute import ComputeManagementClient from azure.mgmt.resource import SubscriptionClient

---------------------------------------------------------------------------

User‑specific constants

---------------------------------------------------------------------------

TENANT_ID = "tenantid"  # ⇦ replace with your tenant ID or set to None TIMEZONE = ZoneInfo("Europe/Paris")  # “W. Europe Standard Time” equivalent

Tag validation pattern (verbatim from the PowerShell script)

TAG_PATTERN = re.compile( r"""^Monday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Tuesday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Wednesday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Thursday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Friday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Saturday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE);Sunday\s+(((([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M-(([0-9]|1[0-2])|0[0-9]):(([0-9]|[1-5][0-9])|0[0-9])[AP]M)|NONE)$""".replace("\n", "").replace(" ", ""), re.IGNORECASE, )

---------------------------------------------------------------------------

Helper functions

---------------------------------------------------------------------------

def get_power_state(instance_view) -> str: """Return Azure‐style power state display string, e.g. "VM running".""" for status in (instance_view.statuses or []): if status.code.startswith("PowerState/"): return status.display_status return "Unknown"

def parse_autoshutdown(tag_value: str, current_day: str) -> Tuple[datetime | None, datetime | None]: """Parse the AutoShutdown tag for current_day.

Returns a tuple (start_dt, stop_dt) as aware datetimes in *TIMEZONE*,
or (None, None) if the schedule for the day is ``NONE`` or not present.
"""
for day_entry in tag_value.split(";"):
    try:
        day_name, schedule = day_entry.strip().split(" ", 1)
    except ValueError:
        continue  # Malformed; allow validation layer to warn

    if day_name.lower() != current_day.lower():
        continue

    if schedule.lower() == "none":
        return None, None

    start_str, stop_str = (s.strip() for s in schedule.split("-", 1))
    today = datetime.now(TIMEZONE).date()

    start_dt = datetime.combine(today, datetime.strptime(start_str, "%I:%M%p").time(), TIMEZONE)
    stop_dt = datetime.combine(today, datetime.strptime(stop_str, "%I:%M%p").time(), TIMEZONE)
    return start_dt, stop_dt

# Day not found ⇒ default to “no schedule”
return None, None

---------------------------------------------------------------------------

Main workflow

---------------------------------------------------------------------------

def main() -> None: now = datetime.now(TIMEZONE) current_day = now.strftime("%A")

credential = DefaultAzureCredential()
subs_client = SubscriptionClient(credential)

# -------------------------------------------------------------------
# Enumerate subscriptions first
# -------------------------------------------------------------------
for sub in subs_client.subscriptions.list():
    # Skip disabled or non‑matching names
    if sub.state != "Enabled":
        continue
    if not re.match(r"^(PRD|PPD|OTH)[ \t]-[ \t]", sub.display_name):
        continue

    print(f"\n== Processing subscription: {sub.display_name} ({sub.subscription_id}) ==")
    compute = ComputeManagementClient(credential, sub.subscription_id)

    # ----------------------------------------------------------------
    # Enumerate VMs inside the subscription
    # ----------------------------------------------------------------
    for vm in compute.virtual_machines.list_all():
        tags = vm.tags or {}
        if "AutoShutdown" not in tags:
            continue  # Ignore machines without the tag

        tag_value = tags["AutoShutdown"]
        resource_group = vm.id.split("/")[4]  # /subscriptions/.../resourceGroups/{rg}/providers/...

        # Validate tag syntax
        if not TAG_PATTERN.match(tag_value):
            print(f"WARNING: Invalid AutoShutdown tag | {sub.display_name} | {vm.name} | {tag_value}")
            continue

        iview = compute.virtual_machines.instance_view(resource_group, vm.name)
        power_state = get_power_state(iview)

        # Parse today’s schedule
        start_dt, stop_dt = parse_autoshutdown(tag_value, current_day)

        print(f"{sub.display_name} | {vm.name} | {power_state} | {tag_value}")

        # ----------------------------------------------------------------
        # Decision tree (faithful to PowerShell logic)
        # ----------------------------------------------------------------
        if start_dt and stop_dt:
            # --- We have a schedule for today
            if (
                power_state != "VM running"
                and now < stop_dt
                and now + timedelta(minutes=10) >= start_dt
            ):
                # Within 10 minutes before start ⇒ start VM
                print(f"→ Starting VM (scheduled window) ...")
                compute.virtual_machines.begin_start(resource_group, vm.name)
                continue  # Move to next VM

            if (
                power_state != "VM deallocated"
                and now >= stop_dt + timedelta(minutes=10)
            ):
                # More than 10 minutes past stop ⇒ deallocate VM
                print(f"→ Stopping VM (end of window) ...")
                compute.virtual_machines.begin_deallocate(resource_group, vm.name, skip_shutdown=True)
                continue
        else:
            # --- “NONE” schedule for today
            if power_state != "VM deallocated":
                print("→ Stopping VM (no schedule today) ...")
                compute.virtual_machines.begin_deallocate(resource_group, vm.name, skip_shutdown=True)

print("\nCompleted successfully.")

if name == "main": try: main() except KeyboardInterrupt: sys.exit("Interrupted by user") except Exception as exc:  # noqa: BLE001 print(f"ERROR: {exc}", file=sys.stderr) sys.exit(1)

